{
  "name": "medusa-temp",
  "private": false,
  "packageManager": "npm@11.16.0",
  "engines": {
    "node": ">=20"
  },
 "scripts": {
  "predev": "docker compose up -d postgres && wait-on tcp:127.0.0.1:5432 -t 60000",
  "dev": "turbo dev",
  "build": "turbo build",
  "start": "turbo start",
  "lint": "turbo lint",
  "test": "turbo test",

  "backend:seed": "turbo seed --filter=@dtc/backend",
  "backend:dev": "turbo dev --filter=@dtc/backend",
  "backend:migrate": "npm exec --workspace=@dtc/backend -- medusa db:migrate",
  "storefront:dev": "turbo dev --filter=@dtc/storefront",

  "infra:up": "docker compose up -d postgres && wait-on tcp:127.0.0.1:5432 -t 60000",
  "infra:down": "docker compose down",
  "infra:reset": "docker compose down -v",
  "infra:logs": "docker compose logs -f postgres",
  "db:setup": "npm run backend:migrate && npm run backend:seed"
},
  "pnpm": {
    "overrides": {
      "@types/react": "19.0.5",
      "@types/react-dom": "19.0.5"
    }
  },
  "devDependencies": {
    "@medusajs/eslint-plugin": "2.16.0",
    "@playwright/test": "^1.62.1",
    "eslint": "^9.39.4",
    "jiti": "^2.7.0",
    "prettier": "^3.2.5",
    "turbo": "^2.0.14",
    "wait-on": "^8.0.1"
  },
  "workspaces": [
    "apps/**",
    "!apps/backend/.medusa/**"
  ],
  "overrides": {
    "schema-utils": {
      "ajv": "^6.12.4",
      "ajv-keywords": "^3.5.2"
    }
  }
}
